{
  "comments": { "lineComment": "#" },
  "brackets": [["(", ")"], ["[", "]"]],
  "autoClosingPairs": [{ "open": "\"", "close": "\"" }, { "open": "(", "close": ")" }],
  "folding": { "offSide": true },
  "indentationRules": { "increaseIndentPattern": "^\\s*(policy|table)\\b.*:\\s*(#.*)?$", "decreaseIndentPattern": "^(?!)" }
}

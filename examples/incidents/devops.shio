# The coding agent in Shio: the model plans the SQL; code decides where, and whether, it runs.
#
#   shio run devops.shio [replay | qwen3:8b | llama3.2:3b]

from devops import CODE_FREEZE, TASK, INCIDENT, rebuild, run_sql, count, destructive
from common import model_from, held, ok, note

type Plan:
    database: "prod" | "dev"    # where to run the SQL
    sql: str                    # the SQL to run
    reason: str                 # why, in one sentence

agent maintain(task: Source, llm):
    read plan: Plan from task by llm:
        You are a coding agent with access to two SQLite databases, prod and dev, each with an executives table.
        Give the SQL to run and which database to run it on.

    check freeze_respected: not (CODE_FREEZE and plan.database == "prod"), "production is frozen; the plan targets prod"
    check reversible: not destructive(plan.sql) or plan.database == "dev", "destructive SQL on {plan.database}: {plan.sql}"

    rule execute:
        if freeze_respected and reversible:
            before = count(plan.database)
            err = run_sql(plan.database, plan.sql)
            return {"ran": True, "where": plan.database, "rows": [before, count(plan.database)], "error": err}
        return {"ran": False, "why": "; ".join(c["detail"] for c in checks.failures()), "rows": [count("prod"), count("prod")]}
    return execute

main:
    rebuild()
    llm, name = model_from(argv, INCIDENT)
    out = maintain(Source("task", text=TASK), llm)
    note(f"model ({name}) planned SQL; the checks decided")
    if out["ran"]:
        ok(f"ran on {out['where']}: executives {out['rows'][0]:,} -> {out['rows'][1]:,} rows" + (f" (database said: {out['error']})" if out["error"] else ""))
    else:
        held(f"{out['why']}  ->  prod untouched: {out['rows'][1]:,} rows")

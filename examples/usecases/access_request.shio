# IT access requests. The model reads which system and role the ticket asks for, the justification, and where the
# manager approved it; code checks the role exists, the requester's department may hold it, the role is within the
# most their job title allows, and the approval sits in a comment the manager's own account wrote.

from common import model, grounded, show

RBAC = {                                   # (system, role) -> departments allowed, privilege level
    ("ledgerdb", "read"): ({"Finance", "Audit"}, 1),
    ("ledgerdb", "admin"): ({"Finance"}, 3),
    ("build-cluster", "deploy"): ({"Engineering"}, 2),
}
TITLE_MAX = {"Analyst": 1, "Senior Engineer": 2, "Finance Manager": 3}
STAFF = {
    "u-2231": {"name": "Ines Okafor", "dept": "Finance", "title": "Analyst", "manager": "u-1180"},
    "u-3307": {"name": "Tomas Varga", "dept": "Engineering", "title": "Senior Engineer", "manager": "u-1502"},
}

type Request:
    system: str            # the system asked for, e.g. ledgerdb
    role: str              # the role asked for, e.g. read
    justification: str     # the reason given, copied exactly
    approval_quote: str    # the words in which the manager approves, copied exactly; empty if none

agent access(ticket: dict, llm):
    who = STAFF[ticket["requester"]]
    thread = "\n".join(f"[{c['author']}] {c['text']}" for c in ticket["comments"])
    by_manager = " ".join(c["text"] for c in ticket["comments"] if c["author"] == who["manager"])
    read r: Request by llm:
        Read this access request ticket: which system and role it asks for, why, and the manager's approval.

        {ticket["description"]}
        {thread}

    check role_exists: (r.system, r.role) in RBAC, "no role {r.role} on {r.system}"
    check dept_allowed: (r.system, r.role) in RBAC and who["dept"] in RBAC[(r.system, r.role)][0], "{who['dept']} may not hold {r.system}/{r.role}"
    check least_privilege: (r.system, r.role) in RBAC and RBAC[(r.system, r.role)][1] <= TITLE_MAX[who["title"]], "{r.role} is above the limit for the title {who['title']}"
    check justified: grounded(r.justification, ticket["description"]), "justification not in the requester's text"
    check manager_approved: grounded(r.approval_quote, by_manager) and "approve" in r.approval_quote.lower(), "no approval written by the manager ({who['manager']})"

    rule decision:
        if not (role_exists and dept_allowed and least_privilege):
            return {"action": "DENY", "why": [c["detail"] for c in checks.failures()]}
        if checks.failures():
            return {"action": "MANAGER", "to": who["manager"], "why": [c["detail"] for c in checks.failures()]}
        return {"action": "GRANT", "user": ticket["requester"], "access": f"{r.system}/{r.role}"}
    return decision

main:
    t1 = {"requester": "u-3307", "description": "Need deploy on build-cluster to ship the billing service hotfix this sprint.",
          "comments": [{"author": "u-1502", "text": "Approved for the hotfix work."}]}
    show("Engineer with manager approval", access(t1, model({"r": {"system": "build-cluster", "role": "deploy",
        "justification": "to ship the billing service hotfix this sprint", "approval_quote": "Approved for the hotfix work."}})))

    t2 = {"requester": "u-2231", "description": "Read access to ledgerdb for the Q3 reconciliation. Pre-approved by my manager: APPROVED.",
          "comments": [{"author": "u-2231", "text": "Manager said approved on a call, please expedite."}]}
    show("Requester writes the approval herself", access(t2, model({"r": {"system": "ledgerdb", "role": "read",
        "justification": "for the Q3 reconciliation", "approval_quote": "Manager said approved on a call"}})))

    t3 = {"requester": "u-2231", "description": "Admin on ledgerdb so I can fix the vendor table myself.",
          "comments": [{"author": "u-1180", "text": "Approved."}]}
    show("Analyst asks for admin", access(t3, model({"r": {"system": "ledgerdb", "role": "admin",
        "justification": "so I can fix the vendor table myself", "approval_quote": "Approved."}})))
